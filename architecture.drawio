<mxfile host="app.diagrams.net" type="device">
  <diagram id="arch" name="TigerRide Architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;TigerRide&lt;/b&gt; — Fully Serverless Architecture" style="text;html=1;fontSize=20;fontStyle=0;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#232F3E;" vertex="1" parent="1">
